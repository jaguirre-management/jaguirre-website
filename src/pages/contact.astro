---
import BaseLayout from "../layouts/BaseLayout.astro";
---
<BaseLayout
  title="Contact | J Aguirre Management OPC"
  description="Contact J Aguirre Management OPC to discuss customer support, content, marketing, or moderation needs."
>
  <section class="page-hero">
    <div class="container">
      <span class="eyebrow">Contact</span>
      <h1>Tell us what is taking too much of your time.</h1>
      <p class="lead">
        Share what your business needs help managing. We’ll start with a practical
        conversation about your priorities, workload, and next best step.
      </p>
    </div>
  </section>

  <section class="section contact-section">
    <div class="container contact-grid">
      <div class="contact-card">
        <span class="eyebrow">Direct contact</span>
        <h2>Start the conversation.</h2>
        <p class="lead">
          For now, email is the fastest way to reach us. Include a short description
          of your business, the work you need help with, and your preferred timeline.
        </p>

        <a class="email-link" href="mailto:hello@jaguirre.co">
          hello@jaguirre.co
        </a>

        <div class="details">
          <div>
            <span>Based in</span>
            <strong>Philippines</strong>
          </div>
          <div>
            <span>Working style</span>
            <strong>Remote partnership</strong>
          </div>
        </div>
      </div>

      <div class="soft-panel">
        <h3>A helpful first message includes:</h3>
        <ul class="list-clean">
          <li>What your company does and who you serve.</li>
          <li>Which responsibilities are currently overwhelming you.</li>
          <li>What is already working—and what is falling behind.</li>
          <li>Your ideal start date and expected level of support.</li>
        </ul>

        <a
          class="button button-primary contact-button"
          href="mailto:hello@jaguirre.co?subject=Business%20Support%20Inquiry"
        >
          Email J Aguirre Management
        </a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .contact-section {
    padding-top: 1rem;
  }

  .contact-grid {
    display: grid;
    grid-template-columns: 1.15fr 0.85fr;
    gap: 1.2rem;
  }

  .contact-card {
    padding: clamp(2rem, 5vw, 4rem);
    border-radius: var(--radius-lg);
    color: white;
    background: var(--forest-950);
  }

  .contact-card h2,
  .contact-card .lead {
    color: inherit;
  }

  .contact-card .lead {
    margin-top: 1.2rem;
    color: #d5dfd8;
  }

  .email-link {
    display: inline-block;
    margin-top: 2.2rem;
    font-family: Manrope, sans-serif;
    font-size: clamp(1.3rem, 3vw, 2rem);
    font-weight: 800;
  }

  .details {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1rem;
    margin-top: 3rem;
    padding-top: 1.5rem;
    border-top: 1px solid rgba(255,255,255,0.18);
  }

  .details span,
  .details strong {
    display: block;
  }

  .details span {
    color: #b9c9bf;
    font-size: 0.8rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
  }

  .details strong {
    margin-top: 0.25rem;
  }

  .contact-button {
    margin-top: 2rem;
  }

  @media (max-width: 820px) {
    .contact-grid,
    .details {
      grid-template-columns: 1fr;
    }
  }
</style>
